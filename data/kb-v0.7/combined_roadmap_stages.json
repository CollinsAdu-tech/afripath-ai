  {
    "stage_id": "data_careers_stage_12_week_plan",
    "career_id": "career_data_careers",
    "stage_order": 3,
    "title": "Follow the 12-week plan",
    "source_duration": "12 weeks",
    "goal": "Progress steadily, document learning, and complete at least one project.",
    "weekly_plan": [
      {
        "weeks": "1",
        "goal": "Onboard and finish the first module",
        "actions": [
          "Start with an introductory Python or Python-for-data-science module."
        ]
      },
      {
        "weeks": "2",
        "goal": "Finish module 2 and build a vocabulary list",
        "actions": [
          "Record terms, formulas, and common mistakes."
        ]
      },
      {
        "weeks": "3",
        "goal": "Finish module 3 and complete practice",
        "actions": [
          "Use practice challenges to identify weak spots."
        ]
      },
      {
        "weeks": "4",
        "goal": "Finish module 4",
        "actions": [
          "Try a data-wrangling or visualization exercise if included."
        ]
      },
      {
        "weeks": "5",
        "goal": "Continue and start a mini-project folder",
        "actions": [
          "Summarize learning in five bullet points."
        ]
      },
      {
        "weeks": "6",
        "goal": "Finish module 6 and repeat practice",
        "actions": [
          "Redo one or two previously missed exercises."
        ]
      },
      {
        "weeks": "7",
        "goal": "Track progress",
        "actions": [
          "Update a checklist of completed modules and badges."
        ]
      },
      {
        "weeks": "8",
        "goal": "Finish core modules and preview advanced content",
        "actions": [
          "Choose one optional topic to explore next month."
        ]
      },
      {
        "weeks": "9–10",
        "goal": "Complete a guided or self-made project",
        "actions": [
          "Share progress with a peer or mentor."
        ]
      },
      {
        "weeks": "11–12",
        "goal": "Finish the track and polish proof of work",
        "actions": [
          "Update GitHub or LinkedIn and write a short reflection."
        ]
      }
    ],
    "recommended_resource_ids": [
      "data_res_projects",
      "data_res_practice",
      "data_res_github_guide"
    ],
    "source_id": "source_tap_paths_data_careers"
  },
