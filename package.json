{
  "name": "afripath-ai",
  "version": "0.4.0",
  "private": true,
  "description": "Dev helpers for the AfriPath AI monorepo. The engine is Python (FastAPI); Node is used only for the React front end in web/.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "python3 -m pathfinder.api",
    "test": "python3 -m pytest -q",
    "test:web": "npm --prefix web test",
    "build:web": "npm --prefix web run build",
    "test:all": "npm test && npm run test:web",
    "examples": "python3 scripts/generate_examples.py",
    "data-quality": "python3 scripts/generate_data_quality_report.py",
    "openapi": "python3 scripts/sync_openapi.py",
    "recommend": "python3 scripts/recommend.py"
  }
}
